# =============================================================================
# CapsuleCorp Backend - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="CapsuleCorp API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1  # Increase in production (usually CPU cores * 2 + 1)

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=capsule
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_secrets_token_urlsafe

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# KMS Keys (must match PostgreSQL session variables)
# -----------------------------------------------------------------------------
# These keys are used by PostgreSQL functions for encryption
# Generate 32-character keys for AES-256
KMS_MASTER_KEY=your_32_character_master_key_here
AUDIT_HMAC_KEY=your_32_character_hmac_key_here_

# -----------------------------------------------------------------------------
# API Key Provisioning
# -----------------------------------------------------------------------------
# Pre-shared secret for service-to-service API key provisioning
# Services use this secret to obtain API keys without admin credentials
# Generate with: openssl rand -hex 32
API_KEY_PROVISION_SECRET=your_64_character_hex_secret_here

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=console  # console, json

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
